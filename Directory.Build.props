<Project>
  <!-- Shared version / metadata for every project. Bump Version for each release; the
       command-line tool reports it (and the HTA compares it) as the tool version. -->
  <PropertyGroup>
    <Version>0.3.3</Version>
    <Authors>Ben Morris</Authors>
    <Product>Login Activity Triage</Product>
    <Copyright>Copyright (c) 2026 Ben Morris</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
